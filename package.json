{
  "name": "@preview-hub/core",
  "version": "0.1.0",
  "description": "Config-driven multi-role / multi-surface / multi-device preview workbench for React / Next.js apps.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "preview",
    "workbench",
    "multirole",
    "multidevice",
    "iframe",
    "nextjs",
    "react"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "next": ">=14"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": ">=19",
    "@types/react-dom": ">=19",
    "typescript": "^5.9.3"
  }
}
