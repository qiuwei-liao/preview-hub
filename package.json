{
  "name": "@qiuwei-liao/preview-hub",
  "version": "0.2.0",
  "description": "Config-driven multi-role / multi-surface / multi-device preview workbench for React / Next.js apps.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/state/__tests__/*.test.ts src/renderer/__tests__/*.test.tsx",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "preview",
    "workbench",
    "multirole",
    "multidevice",
    "iframe",
    "nextjs",
    "react"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qiuwei-liao/preview-hub.git"
  },
  "homepage": "https://github.com/qiuwei-liao/preview-hub#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": ">=19",
    "@types/react-dom": ">=19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
